rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NOTE: This is a prototype rule set for the static BoostLoop launch.
    // Admin access in the app is client-gated by the secret hash route only.
    // That is hiding, not locking. At production launch, replace the
    // "allow write: if request.auth != null" rules for settings, plans,
    // gateways, announcements, attempts, bans and whitelist with a check
    // that request.auth.uid equals your designated admin Google account uid,
    // and rotate the secret route word.
    match /settings/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /plans/{doc} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
    match /gateways/{doc} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
    match /announcements/{doc} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null;
      allow delete: if false;
    }
    match /campaigns/{doc} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if false;
    }
    match /completions/{doc} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.earnerUid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if false;
    }
    match /withdraws/{doc} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if false;
    }
    match /payments/{doc} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if false;
    }
    match /tickets/{doc} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if false;
    }
    match /history/{doc} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if false;
    }
    match /notifications/{doc} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
    match /attempts/{doc} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }
    match /bans/{doc} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
    match /whitelist/{doc} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
